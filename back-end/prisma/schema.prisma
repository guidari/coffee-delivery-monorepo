generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  description  String
  price  Float
  quantity Int
  tags  String[]
  image  String
  // created_at DateTime @default(now())
  // updated_at DateTime @default(now())
}